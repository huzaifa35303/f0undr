{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/book",
      "destination": "/book/index.html"
    },
    {
      "source": "/book/(.*)",
      "destination": "/book/$1"
    },
    {
      "source": "/urdu-book",
      "destination": "/urdu-book/index.html"
    },
    {
      "source": "/urdu-book/(.*)",
      "destination": "/urdu-book/$1"
    },
    {
      "source": "/mind-mastery",
      "destination": "/mind-mastery/index.html"
    },
    {
      "source": "/mind-mastery/(.*)",
      "destination": "/mind-mastery/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/google(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ]
}
